  </lobby>
  <battle>
    <textStyle>
      <boldTitle>	&lt;font face="$TitleFont" size="14" color="#FFDD99"&gt;%(text)s&lt;/font&gt;	</boldTitle>
      <hwAnomalyDescriptor>	&lt;font face="$FieldFont" size="14" color="#FFDD99"&gt;%(text)s&lt;/font&gt;	</hwAnomalyDescriptor>
      <boldTitleEpic>	&lt;font face="$TitleFont" size="14" color="#CCB4FF"&gt;%(text)s&lt;/font&gt;	</boldTitleEpic>
