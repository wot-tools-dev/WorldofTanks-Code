<messenger.xml>
  <htmlTemplatesSimple>
    <battleResultBossDefeated>	&lt;br/&gt;&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/bossDefeated)&lt;/font&gt;	</battleResultBossDefeated>
    <battleResultPhases>	&lt;br/&gt;&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/phaseCompleted)&lt;/font&gt;	</battleResultPhases>
    <battleResultQuest>	&lt;br/&gt;&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/questCompleted)&lt;br/&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/artefacts): &lt;font color='#C8C8B5'&gt;%(artefacts)s&lt;/font&gt;&lt;/font&gt;	</battleResultQuest>
    <battleResultQuests>	&lt;br/&gt;&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/questsCompleted)&lt;br/&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/artefacts): &lt;font color='#C8C8B5'&gt;%(artefacts)s&lt;/font&gt;&lt;/font&gt;	</battleResultQuests>
  </htmlTemplatesSimple>
  <htmlTemplates>
    <HWVehicleRentMessage>
      <priority>	medium	</priority>
      <type>	grey	</type>
      <icon>	InformationIcon	</icon>
      <message>	&lt;font color="#8C8C7E"&gt;%(description)s&lt;/font&gt;	</message>
    </HWVehicleRentMessage>
    <hwArtefactKeysMessage>
      <priority>	low	</priority>
      <type>	grey	</type>
      <icon>	ArtefactKey	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color="#8C8C7E"&gt;%(description)s&lt;/font&gt;	</message>
    </hwArtefactKeysMessage>
    <hwPurchaseBundleForGoldSysMessage>
      <type>	yellow	</type>
      <icon>	GoldIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(description)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(additionalText)s&lt;/font&gt;	</message>
    </hwPurchaseBundleForGoldSysMessage>
    <hwDifficultyOpenMessageSysMessage>
      <type>	grey	</type>
      <icon>	InformationIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(text)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(description)s&lt;/font&gt;	</message>
    </hwDifficultyOpenMessageSysMessage>
    <hwBattlePassPointsMessage>
      <type>	yellow	</type>
      <icon>	battlePassPoints	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/invoiceReceived/invoice)&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/currencyUpdate/date):&lt;/font&gt; &lt;font color='#8C8C7E'&gt;%(at)s&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:platformCurrencyMsg/received/bpbit): &lt;/font&gt;&lt;br/&gt;&lt;font color='#C8C8B5'&gt;%(bpPoints)s&lt;/font&gt;	</message>
    </hwBattlePassPointsMessage>
    <HWBattleVictoryResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgHWBattleResultIconVictory	</bgIcon>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/battleResults/victory)!&lt;/font&gt;
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/battleTypeName)&lt;/font&gt;
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/difficulty): %(difficultyLevel)s&lt;/font&gt;%(finalResult)s
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/tank): %(vehicleNames)s&lt;/font&gt;
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/artefactKeys): &lt;font color='#C8C8B5'&gt;%(artefactKeys)s&lt;/font&gt;%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(equipCoinStr)s&lt;font color='#929290'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(badges)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s%(artefacts)s	</message>
    </HWBattleVictoryResult>
    <HWbattleDefeatResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgHWBattleResultIconDefeat	  <FORT_BATTLE>	frtClanBtlBgBattleResult_UR_Defeat	</FORT_BATTLE>
      </bgIcon>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/battleResults/ended)&lt;/font&gt;
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/battleTypeName)&lt;/font&gt;
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/difficulty): %(difficultyLevel)s&lt;/font&gt;%(finalResult)s
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/tank): %(vehicleNames)s&lt;/font&gt;
&lt;font color='#929290'&gt;_(#halloween.halloween_system_messages:serviceChannelMessages/battleResults/artefactKeys): &lt;font color='#C8C8B5'&gt;%(artefactKeys)s&lt;/font&gt;%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(equipCoinStr)s&lt;font color='#929290'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(badges)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s%(artefacts)s	</message>
    </HWbattleDefeatResult>
    <CrewRewardNotification>
      <priority>	medium	</priority>
      <groupID>	info	</groupID>
      <gfViewName>	CrewRewardNotification	</gfViewName>
      <linkage>	GamefaceNotification	</linkage>
    </CrewRewardNotification>
  </htmlTemplates>
</messenger.xml>
