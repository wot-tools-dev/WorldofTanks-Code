<messenger.xml>
  <htmlTemplates>
    <fallTanksBattleFinishedResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgFallTanksBattleResultIcon	</bgIcon>
      <bgIconHeight>	100	</bgIconHeight>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#fall_tanks.fall_tanks:serviceChannelMessages/battleResults/finished)&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;
&lt;font color='#929290'&gt;_(#fall_tanks.fall_tanks:serviceChannelMessages/battleResults/finishTime): %(finishTime)s&lt;/font&gt;&lt;font color='#8C8C7E'&gt;%(xp)s%(xpEx)s%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(equipCoinStr)s&lt;font color='#8C8C7E'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s	</message>
    </fallTanksBattleFinishedResult>
    <fallTanksBattleNotFinishedResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgFallTanksBattleResultIcon	</bgIcon>
      <bgIconHeight>	100	</bgIconHeight>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#fall_tanks.fall_tanks:serviceChannelMessages/battleResults/notFinished)!&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s &lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;&lt;font color='#8C8C7E'&gt;%(xp)s%(xpEx)s%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(equipCoinStr)s&lt;font color='#8C8C7E'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s	</message>
    </fallTanksBattleNotFinishedResult>
  </htmlTemplates>
</messenger.xml>
