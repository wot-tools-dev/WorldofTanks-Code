<messenger.xml>
  <htmlTemplates>
    <resourceWellInvoiceReceived>
      <type>	grey	</type>
      <icon>	InformationIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/invoiceReceived/invoice)&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/currencyUpdate/date):&lt;/font&gt; &lt;font color='#8C8C7E'&gt;%(at)s&lt;/font&gt;&lt;/br&gt;
%(text)s	</message>
    </resourceWellInvoiceReceived>
    <ResourceWellRewardReceivedMessage>
      <type>	grey	</type>
      <icon>	resourceWellIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font face="$FieldFont" size="14" color='#8C8C7E'&gt;%(text)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#C9C9B6'&gt;%(additionalText)s&lt;/font&gt;	</message>
    </ResourceWellRewardReceivedMessage>
    <ResourceWellStartSysMessage>
      <type>	grey	</type>
      <priority>	high	</priority>
      <icon>	resourceWellIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(text)s&lt;/font&gt;	</message>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/resourceWell/details/button)	</label>
          <action>	openResourceWellProgressionStartWindow	</action>
        </button>
      </buttonsLayout>
    </ResourceWellStartSysMessage>
    <ResourceWellEndSysMessage>
      <type>	grey	</type>
      <priority>	high	</priority>
      <icon>	resourceWellIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(text)s&lt;/font&gt;	</message>
    </ResourceWellEndSysMessage>
    <ResourceWellNoVehiclesWithButtonMessage>
      <type>	grey	</type>
      <icon>	resourceWellIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(text)s&lt;/font&gt;	</message>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/resourceWell/spendResources/button)	</label>
          <action>	OpenResourceWellProgressionWindow	</action>
        </button>
      </buttonsLayout>
    </ResourceWellNoVehiclesWithButtonMessage>
    <ResourceWellNoVehiclesMessage>
      <type>	grey	</type>
      <icon>	resourceWellIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(text)s&lt;/font&gt;	</message>
    </ResourceWellNoVehiclesMessage>
  </htmlTemplates>
</messenger.xml>
