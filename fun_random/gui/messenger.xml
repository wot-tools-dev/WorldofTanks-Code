<messenger.xml>
  <htmlTemplatesSimple>
    <funRandomLootBox>	&lt;font color='#8C8C7E'&gt;%(text)s: &lt;font color='#D6D7D4'&gt;&lt;b&gt;%(count)s&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;	</funRandomLootBox>
  </htmlTemplatesSimple>
  <htmlTemplates>
    <FunRandomNewSubModes>
      <type>	grey	</type>
      <icon>	InformationIcon	</icon>
      <priority>	medium	</priority>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(header)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(text)s&lt;/font&gt;	</message>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/funRandom/newSubModesButton)	</label>
          <action>	selectFunRandomMode	</action>
          <width>	120	</width>
        </button>
      </buttonsLayout>
    </FunRandomNewSubModes>
    <FunRandomProgressionStage>
      <type>	grey	</type>
      <icon>	InformationIcon	</icon>
      <priority>	medium	</priority>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(header)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(text)s&lt;/font&gt;	</message>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/funRandom/progressionStageButton)	</label>
          <action>	showFunRandomProgression	</action>
          <width>	120	</width>
        </button>
      </buttonsLayout>
    </FunRandomProgressionStage>
    <FunRandomLootBoxesAutoOpenMessage>
      <priority>	medium	</priority>
      <type>	grey	</type>
      <linkage>	SMFunRandomReward	</linkage>
      <message>	&lt;font face="$TitleFont" size="24" color="#FFFFFF"&gt;%(header)s&lt;/font&gt;&lt;br/&gt;&lt;font face="$TitleFont" size="12" color="#E9E2BF"&gt;%(rewardText)s&lt;/font&gt;&lt;br/&gt;	</message>
      <buttonsLayout>
        <button>
          <type>	info	</type>
          <label>	&lt;font face="$TitleFont" size="14" color="#FEFEEC"&gt;_(#messenger:serviceChannelMessages/funRandom/progressionStageButton)&lt;/font&gt;	</label>
          <action>	showFunRandomProgression	</action>
          <width>	128	</width>
        </button>
      </buttonsLayout>
    </FunRandomLootBoxesAutoOpenMessage>
  </htmlTemplates>
</messenger.xml>
