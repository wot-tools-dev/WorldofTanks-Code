    {
      "msgid": "S29_UDES_14_5_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A UDES 14 tank project developed by Bofors. This project was to feature a gun autoloader and hydraulic suspension, as well as the option of manual gun loading. Existed only in blueprints.",
