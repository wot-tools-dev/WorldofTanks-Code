    {
      "msgid": "Pl05_50TP_Tyszkiewicza_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard 50TP",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl05_50TP_Tyszkiewicza_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A project for a heavy tank proposed by cadet Tadeusz Tyszkiewicz at the Military Technical Academy of Warsaw in the early 1950s. The new vehicle was supposed to weigh up to 50 tons. Existed only in blueprints.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl05_50TP_Tyszkiewicza_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl11_45TP_Habicha_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard 45TP",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl11_45TP_Habicha_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A proposed project for a heavy tank. This vehicle was supposed to be a further development of the Habich medium tank. The hull was to feature thicker sloped armor plates and involved equipping a more powerful gun. However, a prototype was never built.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl11_45TP_Habicha_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl13_53TP_Markowskiego_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard 53TP",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl13_53TP_Markowskiego_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A proposed plan for a heavy tank that was to be developed in 1940. Due to the outbreak of World War II, development was discontinued at the blueprints stage.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl13_53TP_Markowskiego_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl18_BUGI_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard B.U.G.I.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl18_BUGI_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "The B.U.G.I. uses the first letters of the last names of the engineers who developed this project (Bujnowicz, Ulrych, Grabski, and Iwanicki). The engineers took the concept of the KSUS II medium tank but adjusted the new vehicle to feature a one-turret design. The project was sent for consideration during the Grudziądz conference in 1938–1939. The project was finalized in May 1939 in the Armed Forces Training Center in Modlin. In mid-August 1939, the engineering group presented the vehicle concept and blueprints. However, further development was discontinued due to World War II.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl18_BUGI_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl20_CS_44_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard CS-44",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl20_CS_44_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A project of a medium tank developed by students of Warsaw University of Technology in the latter half of the 1940s. The project was based on concepts from Soviet and French tank-building. Existed only in blueprints.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl20_CS_44_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl23_CS_53_Alpha_LS_BOT",
      "msgid_plural": null,
      "msgstr": "CS-53",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl23_CS_53_Alpha_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "In the first half of the 1950s, the Military Technical Academy of Warsaw was developing several projects of medium tanks. These projects were greatly influenced by Soviet tank-building. During the development process, Polish experts adopted the technical and configurational concepts used in the experimental, mass-produced Soviet T-54 tank. Existed only in blueprints.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl23_CS_53_Alpha_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "CS-53",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl23_CS_53_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard CS-53",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl23_CS_53_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "In the first half of the 1950s, the Military Technical Academy of Warsaw was developing several projects of medium tanks. These projects were greatly influenced by Soviet tank-building. During the development process, Polish experts adopted the technical and configurational concepts used in the experimental, mass-produced Soviet T-54 tank. Existed only in blueprints.",
      "msgstr_plural": null
    },
    {
      "msgid": "Pl23_CS_53_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
