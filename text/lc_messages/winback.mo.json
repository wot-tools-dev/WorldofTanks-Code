    {
      "msgid": "modeInfoTooltip/description",
      "msgid_plural": null,
      "msgstr": "Battles against AI-controlled vehicles that do not count toward your statistics. To win, you need to capture the enemy base or destroy all enemy vehicles. Battles are fought in the 15v15 format at Tiers VI–XI and in the 10v10 format at Tiers I–V.",
      "msgstr_plural": null
    },
    {
      "msgid": "modeInfoTooltip/maps",
      "msgid_plural": null,
      "msgstr": "Lakeville, Mannerheim Line, Malinovka, Abbey, Mines, Ruinberg, Ensk.",
