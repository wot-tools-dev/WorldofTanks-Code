    {
      "msgid": "selectableRewardTooltip/discount/footer",
      "msgid_plural": null,
      "msgstr": "The discount on {{@ style (color $color)}}researching{{/}} is added to the discount from the vehicle blueprint fragments. The largest available {{@ style (color $color)}}purchasing{{/}} discount is applied.",
