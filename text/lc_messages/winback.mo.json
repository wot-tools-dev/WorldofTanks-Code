    {
      "msgid": "umgIntroView/info/mode/description",
      "msgid_plural": null,
      "msgstr": "Warm-Up will remind you of the game basics. Battles are played against AI-controlled vehicles and the results do not count toward your statistics. You can exit Warm-Up at any time to proceed to Random Battles.",
      "msgstr_plural": null
    },
    {
      "msgid": "umgIntroView/info/mode/title",
      "msgid_plural": null,
      "msgstr": "Warm-Up",
      "msgstr_plural": null
    },
    {
      "msgid": "umgIntroView/info/quests/description/battlePass",
      "msgid_plural": null,
      "msgstr": "Complete missions, finish the Back in Action Progression Stages, and receive valuable rewards. During Battle Pass, Battle Pass Points will be added to the pool of rewards. Missions can be completed in Warm-Up and Random Battles.",
      "msgstr_plural": null
    },
    {
      "msgid": "umgIntroView/info/quests/description/default",
      "msgid_plural": null,
      "msgstr": "Complete missions, finish the Back in Action Progression Stages, and receive valuable in-game rewards. Each completed Standard, Premium, or Bonus Mission counts toward the reward. Missions can be completed in Warm-Up and Random Battles.",
      "msgstr_plural": null
    },
    {
      "msgid": "umgIntroView/info/quests/title",
      "msgid_plural": null,
      "msgstr": "Back in Action",
      "msgstr_plural": null
    },
    {
      "msgid": "umgIntroView/info/rewards/description",
      "msgid_plural": null,
      "msgstr": "You can earn rental Tier VIII Premium vehicles, Tier VI researchable vehicles, and discounts on researching and purchasing vehicles as a reward. After completing the Progression, you will receive the main reward.",
