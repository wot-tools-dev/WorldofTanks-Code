      "msgstr": "Archer",
      "msgstr_plural": null
    },
    {
      "msgid": "A35_Pershing_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard Pershing",
      "msgstr_plural": null
    },
    {
      "msgid": "A35_Pershing_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "American medium tank, named in honor of General John Pershing, who led the American Expeditionary Force during World War I. In 1944–1946 in the U.S. Army, the M26 was temporarily classified as heavy tank. Starting in February 1945 these vehicles took part in World War II; in 1950–1951 the vehicle saw combat in the Korean War.",
      "msgstr_plural": null
    },
    {
      "msgid": "A35_Pershing_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "A63_M46_Patton_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard M46 Patton",
      "msgstr_plural": null
    },
    {
      "msgid": "A63_M46_Patton_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "Developed in 1948 and 1949, the M46 Patton was a modernized and improved version of the M26 Pershing. A total of 1,168 M46 tanks, in two basic variants, were manufactured between 1949 and 1951. Pattons saw wide use in the Korean War.",
      "msgstr_plural": null
    },
    {
      "msgid": "A63_M46_Patton_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "A66_M103_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard M103",
      "msgstr_plural": null
    },
    {
      "msgid": "A66_M103_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "The development started in 1948. In 1952 the order was placed for production of 300 vehicles to fight in the Korean War. The tank was designated as M103.",
      "msgstr_plural": null
    },
    {
      "msgid": "A66_M103_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "A69_T110E5_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard T110E5",
      "msgstr_plural": null
    },
    {
      "msgid": "A69_T110E5_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "Developed from 1952 as a heavy tank with more powerful armament, compared to the T-43 (M103). Restrictions were placed on the vehicle sizing as the tank was supposed to pass through the narrow tunnels of the Bernese Alps. Several designs were considered, but the project was canceled. No vehicles were ever manufactured.",
      "msgstr_plural": null
    },
    {
      "msgid": "A69_T110E5_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
