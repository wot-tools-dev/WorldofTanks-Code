  "entries": [
    {
      "msgid": "A100_T49_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Lost Grenadier",
      "msgstr_plural": null
    },
    {
      "msgid": "A100_T49_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A variant of the M41 light tank with an enlarged turret and 90-mm gun. Trials started on May 5, 1954. The trials were a success, but the tank never saw mass production due to lack of interest from the military authorities.",
      "msgstr_plural": null
    },
    {
      "msgid": "A100_T49_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Lost",
      "msgstr_plural": null
    },
    {
      "msgid": "A12_T32_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard T32",
      "msgstr_plural": null
    },
    {
      "msgid": "A12_T32_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "An experimental World War II American heavy tank. Developed on the basis of the M26 Pershing and T29 tanks. Prototypes were built in 1946; however, the T32 never entered mass production.",
      "msgstr_plural": null
    },
    {
      "msgid": "A12_T32_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "A12_T32_LS_PLAYER",
      "msgid_plural": null,
      "msgstr": "T32",
      "msgstr_plural": null
    },
    {
      "msgid": "A12_T32_LS_PLAYER_descr",
      "msgid_plural": null,
      "msgstr": "An experimental World War II American heavy tank. Developed on the basis of the M26 Pershing and T29 tanks. Prototypes were built in 1946; however, the T32 never entered mass production.",
      "msgstr_plural": null
    },
    {
      "msgid": "A130_Super_Hellcat_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Archer",
      "msgstr_plural": null
    },
    {
