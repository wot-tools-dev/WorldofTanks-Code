    {
      "msgid": "F110_Lynx_6x6_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Trapper",
      "msgstr_plural": null
    },
    {
      "msgid": "F110_Lynx_6x6_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A further development of the Panhard AML armored vehicle with six-wheel-drive suspension, new turret, and more powerful armament.",
      "msgstr_plural": null
    },
    {
      "msgid": "F110_Lynx_6x6_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Trapper",
      "msgstr_plural": null
    },
    {
      "msgid": "F17_AMX_13_90_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Corrupted Hornet",
      "msgstr_plural": null
    },
    {
      "msgid": "F17_AMX_13_90_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A fast and maneuverable vehicle with a 5-shell magazine loading system.",
      "msgstr_plural": null
    },
    {
      "msgid": "F17_AMX_13_90_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Corrupted",
      "msgstr_plural": null
    },
    {
      "msgid": "F71_AMX_30_prototype_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard A.P. AMX 30",
      "msgstr_plural": null
    },
    {
      "msgid": "F71_AMX_30_prototype_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "Developed as part of a competitive search for a unified European tank. The vehicle turned out to have maneuverability, engine power, and effective anti-tank engagement distance superior to all other vehicles except the Leopard 1. The armor of the vehicle was quite thin, but it was decided that technological advances in anti-tank shells had essentially rendered armor obsolete: survivability would depend on mobility and firepower.",
      "msgstr_plural": null
    },
    {
      "msgid": "F71_AMX_30_prototype_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "F73_M4A1_Revalorise_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard M4A1 Rev.",
      "msgstr_plural": null
    },
    {
      "msgid": "F73_M4A1_Revalorise_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "In the 1950s, the M4 Sherman of various modifications was supplied to France as part of MDAP. French design bureaus started modernizing the vehicle with the goal of improving its firepower. This initiative was followed by a modernization program for the Israel Defense Forces (Sherman M51). The tank never saw service in France. The number of prototypes built is unknown.",
      "msgstr_plural": null
    },
    {
      "msgid": "F73_M4A1_Revalorise_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "F74_AMX_M4_1949_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard AMX M4 49",
      "msgstr_plural": null
    },
    {
      "msgid": "F74_AMX_M4_1949_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A heavy tank that was originally known as Project 141. Since France needed modern heavy tanks, development started immediately after World War II. Existed only in blueprints.",
      "msgstr_plural": null
    },
    {
      "msgid": "F74_AMX_M4_1949_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "F82_AMX_M4_Mle1949_Ter_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard AMX M4 54",
      "msgstr_plural": null
    },
    {
      "msgid": "F82_AMX_M4_Mle1949_Ter_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "A variant of the AMX M4 heavy tank based on the Project 141 with reinforced front armor. It was planned to enhance the front armor by mounting a 280-mm armor plate. Existed only in blueprints.",
      "msgstr_plural": null
    },
    {
      "msgid": "F82_AMX_M4_Mle1949_Ter_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
    {
      "msgid": "F83_AMX_M4_Mle1949_Bis_LS_BOT",
      "msgid_plural": null,
      "msgstr": "Guard AMX M4 51",
      "msgstr_plural": null
    },
    {
      "msgid": "F83_AMX_M4_Mle1949_Bis_LS_BOT_descr",
      "msgid_plural": null,
      "msgstr": "The Project 141 was a variant of the AMX M4 heavy tank with reinforced front armor. Development started in November 1949, but the vehicle was never built. The project also included many calculations for different hulls on a similar chassis.",
      "msgstr_plural": null
    },
    {
      "msgid": "F83_AMX_M4_Mle1949_Bis_LS_BOT_short",
      "msgid_plural": null,
      "msgstr": "Guard",
      "msgstr_plural": null
    },
