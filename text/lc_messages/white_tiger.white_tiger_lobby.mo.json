    {
      "msgid": "crewPanel/slogan/boss",
      "msgid_plural": null,
      "msgstr": "Humanity still believes the mind is its privilege. Very well. I shall correct that.",
      "msgstr_plural": null
    },
    {
      "msgid": "crewPanel/slogan/hunter_1",
      "msgid_plural": null,
      "msgstr": "Whatever it is, it's still made of something I can break.",
      "msgstr_plural": null
    },
    {
      "msgid": "crewPanel/slogan/hunter_2",
      "msgid_plural": null,
      "msgstr": "Every machine has a flaw. I'll find this one's.",
      "msgstr_plural": null
    },
    {
      "msgid": "crewPanel/slogan/hunter_3",
      "msgid_plural": null,
      "msgstr": "Patterns are for people who repeat themselves.",
      "msgstr_plural": null
    },
    {
      "msgid": "crewPanel/slogan/hunter_4",
      "msgid_plural": null,
      "msgstr": "Let it learn from us. We'll teach it the wrong thing.",
      "msgstr_plural": null
    },
