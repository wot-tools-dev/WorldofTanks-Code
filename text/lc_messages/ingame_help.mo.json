    {
      "msgid": "detailsHelp/devMaps/headerTitle",
      "msgid_plural": null,
      "msgstr": "Map Features",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/devMaps/markers/description",
      "msgid_plural": null,
      "msgstr": "The random event location will be marked with\nsmoke on the map and a marker on the minimap.\nMaps with random events can be disabled via the settings in the Game tab.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/devMaps/title",
      "msgid_plural": null,
      "msgstr": "Maps With Random Events",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/devMaps/zone/description",
      "msgid_plural": null,
      "msgstr": "Your vehicle can be destroyed in a random event area (for example, during a plane crash).\nMaps with random events can be disabled via the settings in the Game tab.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/dualGun/quick_fire",
      "msgid_plural": null,
      "msgstr": "Vehicles with this firing system switch guns upon firing. One fired gun starts reloading automatically, while the second loaded gun will have to wait a little.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/dualGun/quick_fire/title",
      "msgid_plural": null,
      "msgstr": "Rapid Fire",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/dualGun/volley_fire",
      "msgid_plural": null,
      "msgstr": "Vehicles with the double-barreled gun system are provided with a special salvo fire mechanic that is activated by holding down the assigned key. The fired shells fly parallel to each other. The button to control firing can be changed in Settings.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/dualGun/volley_fire/title",
      "msgid_plural": null,
      "msgstr": "Salvo Fire",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/engineMode/engineModePage1",
      "msgid_plural": null,
      "msgstr": "You can switch engine modes to suit the specific tactical situation. Changing engine modes requires a complete stop and takes a particular amount of time that does not depend on the state of the module.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/engineMode/engineModePage1/title",
      "msgid_plural": null,
      "msgstr": "New Movement Mechanics",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/engineMode/engineModePage2",
      "msgid_plural": null,
      "msgstr": "The charged turbine mode increases engine power, forward speed, and reverse speed. However, this mode makes your vehicle more visible, reduces gun stabilization, and increases aiming time.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/engineMode/engineModePage2/title",
      "msgid_plural": null,
      "msgstr": "Advantages and Disadvantages",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mapbox/headerTitle",
      "msgid_plural": null,
      "msgstr": "Map Features",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mapbox/localWeather/description",
      "msgid_plural": null,
      "msgstr": "Vehicles within a local weather zone cannot spot vehicles outside the zone and vice versa, or exchange information on the positions of enemy vehicles outside the zone. Fire damages the vehicles.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mapbox/localWeather/title",
      "msgid_plural": null,
      "msgstr": "Local Weather",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/accuracyStacks/page1/description",
      "msgid_plural": null,
      "msgstr": "Remaining stationary or moving below a certain speed allows your vehicle to calibrate its Analog Ballistic Computing Device and build accuracy levels.\nEach level increases the accuracy of your next shot and is removed upon firing.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/accuracyStacks/page1/title",
      "msgid_plural": null,
      "msgstr": "Analog Ballistic Computing Device",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/accuracyStacks/page2/description",
      "msgid_plural": null,
      "msgstr": "At full calibration, your vehicle reaches the highest accuracy level and gains decent gun stabilization, with reduced dispersion during movement or turret/hull traverse.\nThe effect is removed upon firing.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/accuracyStacks/page2/title",
      "msgid_plural": null,
      "msgstr": "Full Calibration",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/autoShootGun/page1/description",
      "msgid_plural": null,
      "msgstr": "A type of automatic firearm with an extremely high rate of fire. Firing effectiveness is shown by an indicator in the aiming circle.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/autoShootGun/page1/title",
      "msgid_plural": null,
      "msgstr": "Autogun",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/autoShootGun_overheatGun/page1/description",
      "msgid_plural": null,
      "msgstr": "This gun can fire continuously without the need for reload. Each shot generates heat, and continuous firing will cause the gun to overheat, preventing further firing until it cools down.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/autoShootGun_overheatGun/page1/title",
      "msgid_plural": null,
      "msgstr": "Thermal Overheat Control Autocannon",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/autoreloaderSurge/page1/description",
      "msgid_plural": null,
      "msgstr": "The mechanism instantly reduces shell reload to a short fixed time. Each use consumes one charge per shell, and charges replenish over time—faster when the clip is full. A set number of charges is available at the start of battle.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/autoreloaderSurge/page1/title",
      "msgid_plural": null,
      "msgstr": "Forced Loading Mechanism",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/auxiliaryRocketLauncher/page1/description",
      "msgid_plural": null,
      "msgstr": "This vehicle is equipped with a rocket launcher mounted in the gun mantlet. To switch to rocket aiming sight, press:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/auxiliaryRocketLauncher/page1/title",
      "msgid_plural": null,
      "msgstr": "Coaxial Rocket Launcher",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/auxiliaryRocketLauncher/page2/description",
      "msgid_plural": null,
      "msgstr": "While aiming with the rocket sight, press the fire button to launch a rocket:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/auxiliaryRocketLauncher/page2/title",
      "msgid_plural": null,
      "msgstr": "Coaxial Rocket Launcher",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/battleFury/page1/description",
      "msgid_plural": null,
      "msgstr": "Every time you hit an enemy with a shell, you gain a reload efficiency level, temporarily boosting your gun's reload speed. Levels accumulate with each hit.\nDestroying an enemy vehicle with a shell grants additional reload efficiency levels.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/battleFury/page1/title",
      "msgid_plural": null,
      "msgstr": "Semi-Automatic Ammo Rack",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/bustleFeed/page1/description",
      "msgid_plural": null,
      "msgstr": "This vehicle's External Ammunition Supply Module allows it to fire powerful high-charge unitary rounds that cause increased damage. While active, the module also reduces mobility and fire rate.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/bustleFeed/page1/title",
      "msgid_plural": null,
      "msgstr": "External Ammunition Feed mode",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/chargeShot/page1/description",
      "msgid_plural": null,
      "msgstr": "If your gun is loaded, you can begin heating your next shot. The higher the heat level you reach, the greater the bonus to average damage will be.\nTo start the heating process, press:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/chargeShot/page1/title",
      "msgid_plural": null,
      "msgstr": "Thermo-Ballistic Overcharge",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/chargeShot/page2/description",
      "msgid_plural": null,
      "msgstr": "When you reach maximum heat level, a countdown begins. If you do not fire before it ends, you will be unable to shoot or change shells for several seconds.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/chargeShot/page2/title",
      "msgid_plural": null,
      "msgstr": "Charge Overheating",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/chargeableBurst/page1/description",
      "msgid_plural": null,
      "msgstr": "Scoring two armor-penetrating hits on enemy vehicles activates Burst mode, loading a burst-fire cassette that allows two shells to be fired in quick succession with the next shot.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/chargeableBurst/page1/title",
      "msgid_plural": null,
      "msgstr": "Burst mode",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/concentrationMode/page1/description",
      "msgid_plural": null,
      "msgstr": "The Pneumatic Gyro-Stabilizer grants maximum stabilization during hull and turret traverse for a short time, allowing for more accurate firing on the move and quick reaction to sudden threats.\nTo activate it, press the hotkey:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/concentrationMode/page1/title",
      "msgid_plural": null,
      "msgstr": "Pneumatic Gyro-Stabilizer",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/dualAccuracy/page1/description",
      "msgid_plural": null,
      "msgstr": "If a gun has cooled down sufficiently after firing, its dispersion will be reduced. A second aiming circle with a smaller diameter will appear, which will determine the area of shell impact. This effect lasts until the next shot is fired.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/dualAccuracy/page1/title",
      "msgid_plural": null,
      "msgstr": "Double Aiming",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/extraShotClip/page1/description",
      "msgid_plural": null,
      "msgstr": "The system automatically starts loading a new cassette when one shell remains in the current one.\nFiring the final shell while the new cassette is being loaded adds several seconds to the remaining reload time.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/extraShotClip/page1/title",
      "msgid_plural": null,
      "msgstr": "Cassette Loading System",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/heatingZonesGun/page1/description",
      "msgid_plural": null,
      "msgstr": "The system keeps the gun cooled, allowing for highly accurate firing. The gun heats up when fired, but begins cooling down and returns to improved parameters during reload. The higher its temperature, the more some of its parameters change.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/heatingZonesGun/page1/title",
      "msgid_plural": null,
      "msgstr": "Active Gun Cooling",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/improvedRamming/page1/description",
      "msgid_plural": null,
      "msgstr": "This vehicle is specially configured for ramming attacks, with a series of design modifications that help it inflict more ramming damage.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/improvedRamming/page1/title",
      "msgid_plural": null,
      "msgstr": "Ramming Configuration",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/lowChargeShot/page1/description",
      "msgid_plural": null,
      "msgstr": "This vehicle's gun can fire early: single-charge shots, fired during reload, have reduced effectiveness, while regular full-charge shots fired after reloading have optimal ballistic parameters.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/lowChargeShot/page1/title",
      "msgid_plural": null,
      "msgstr": "Multi-Pack Charge System",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/overheatStacks/page1/description",
      "msgid_plural": null,
      "msgstr": "Remaining stationary or moving below a certain speed generates preheat, which increases the average damage and accuracy of your next shot.\nExceeding the speed limit gradually reduces the bonus, while firing or changing shells instantly resets it.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/overheatStacks/page1/title",
      "msgid_plural": null,
      "msgstr": "Propellant Thermal Control System",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/overheatStacks/page2/description",
      "msgid_plural": null,
      "msgstr": "At maximum preheat level, penetrating the armor of an enemy vehicle with fewer hit points than your average damage—including your accumulated preheat bonus—will cause its ammo rack to explode, instantly destroying the vehicle.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/overheatStacks/page2/title",
      "msgid_plural": null,
      "msgstr": "Decisive Damage",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/powerMode/page1/description",
      "msgid_plural": null,
      "msgstr": "Direct Drive mode provides a significant boost to engine power and top forward speed. The longer you drive forward, the more speed builds, allowing you to traverse the battlefield with ease.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/powerMode/page1/title",
      "msgid_plural": null,
      "msgstr": "Direct Drive",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/propellantAfterburnerGun/page1/description",
      "msgid_plural": null,
      "msgstr": "Over time, the system automatically accumulates a charge, which is partially consumed to boost damage when firing. The higher the charge, the greater the bonus damage.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/propellantAfterburnerGun/page1/title",
      "msgid_plural": null,
      "msgstr": "Induction Propellant Afterburner",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/propellantAfterburnerGun/page2/description",
      "msgid_plural": null,
      "msgstr": "By default, the system only stores the charge up to a certain limit. Disabling the limiter lets it accumulate an even higher charge, granting a much greater damage bonus but reducing gun handling. To toggle the limiter, press:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/propellantAfterburnerGun/page2/title",
      "msgid_plural": null,
      "msgstr": "Limiter",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rechargeableNitro/page1/description",
      "msgid_plural": null,
      "msgstr": "The Liquid Fuel Boosters grant a burst of engine power, allowing for rapid movement across the battlefield—but limiting reverse and traverse speed. They can be toggled on or off at any time, except at critical heat level.\nTo boost, press or hold:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rechargeableNitro/page1/title",
      "msgid_plural": null,
      "msgstr": "Liquid Fuel Boosters",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rechargeableNitro/page2/description",
      "msgid_plural": null,
      "msgstr": "The boosters overheat while active until they reach their critical heat limit, when they become unavailable for reactivation until cooled. Plan your moves carefully to avoid being caught off guard.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rechargeableNitro/page2/title",
      "msgid_plural": null,
      "msgstr": "Critical Heat Level",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rocketAcceleration/page1/description",
      "msgid_plural": null,
      "msgstr": "The use of jet boosters increases the vehicle's mobility. It allows you to take advantageous positions or cross dangerous areas faster. Jet boosters can be activated for a certain time and for a limited number of times per battle. They cannot be deactivated or destroyed.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rocketAcceleration/page1/title",
      "msgid_plural": null,
      "msgstr": "Jet Boosters",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rocketAcceleration/page2/description",
      "msgid_plural": null,
      "msgstr": "Upon activation, jet boosters increase engine power and top forward speed. However, the vehicle becomes less maneuverable and loses reverse speed.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/rocketAcceleration/page2/title",
      "msgid_plural": null,
      "msgstr": "Advantages and Disadvantages",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/shellCalibration/page1/description",
      "msgid_plural": null,
      "msgstr": "When you hit a visible enemy vehicle with a shell, the fuze setter on the next shell is adjusted. If the initial shot penetrated enemy armor, the next shot's damage is increased. If it did not, the next shot's penetration is increased.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/shellCalibration/page1/title",
      "msgid_plural": null,
      "msgstr": "Adjustable Fuze Setter",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/shellParamsSwitcher/page1/description",
      "msgid_plural": null,
      "msgstr": "The vehicle's gun has special devices that allow some shell parameters to be modified before firing. Parameters for different shells vary based on the selected mode, and each mode lets you quickly adapt to different combat situations.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/shellParamsSwitcher/page1/title",
      "msgid_plural": null,
      "msgstr": "Shell Calibration System",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/sightPointer/page1/description",
      "msgid_plural": null,
      "msgstr": "An advanced optics device increases your view range and enhances detection of moving and foliage-hidden vehicles. When activated, it scans a narrow sector in front of your vehicle, revealing concealed targets before a cooldown period.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/sightPointer/page1/title",
      "msgid_plural": null,
      "msgstr": "Infrared Search and Track (IRST)",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/sightPointer/page2/description",
      "msgid_plural": null,
      "msgstr": "However, if it reveals an unspotted enemy, you also immediately become spotted for a set time, and both you and the enemies you spot are notified instantly. You can manually stop the scan and start the device's cooldown after a short delay.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/sightPointer/page2/title",
      "msgid_plural": null,
      "msgstr": "Infrared Search and Track (IRST)",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stagedJetBoosters/page1/description",
      "msgid_plural": null,
      "msgstr": "Solid-fuel thrusters that boost acceleration, mobility, and maneuverability for several seconds. The left and right thrusters can work independently of each other for faster hull traverse, and do not restrict reverse capability.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stagedJetBoosters/page1/title",
      "msgid_plural": null,
      "msgstr": "Sequential Rocket Thrusters",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stanceDance/page1/description",
      "msgid_plural": null,
      "msgstr": "This vehicle features two modes—Turbo and Engagement—which can be switched at any time. The Tactical Power Pack accumulates energy for the active mode.\nTo switch between modes, press:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stanceDance/page1/title",
      "msgid_plural": null,
      "msgstr": "Two Modes",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stanceDance/page2/description",
      "msgid_plural": null,
      "msgstr": "Once the Tactical Power Pack is fully charged, a mode-specific ability becomes available. Activating this ability consumes all accumulated energy and grants powerful bonuses for a short duration.\nTo activate the unique mode ability, press:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stanceDance/page2/title",
      "msgid_plural": null,
      "msgstr": "Mode Abilities",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stationaryReload/page1/description",
      "msgid_plural": null,
      "msgstr": "The External Ammunition Supply Module allows you to interrupt reload and start firing at any time, as long as you still have one shell loaded. To interrupt or resume the reloading process, press the hotkey:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stationaryReload/page1/title",
      "msgid_plural": null,
      "msgstr": "External Ammunition Supply Module",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stationaryReload/page2/description",
      "msgid_plural": null,
      "msgstr": "During reload, the module locks the vehicle's turret and external ammo pods, temporarily preventing you from aiming or firing unless you interrupt it.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/stationaryReload/page2/title",
      "msgid_plural": null,
      "msgstr": "External Ammunition Supply Module",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/supportWeapon/page1/description",
      "msgid_plural": null,
      "msgstr": "This vehicle is equipped with a set of auxiliary weapons whose reload cycle is separate from the main gun, allowing you to cause additional damage in key moments. To activate auxiliary weapons, press the hotkey:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/supportWeapon/page1/title",
      "msgid_plural": null,
      "msgstr": "Auxiliary Weapons",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/targetDesignator/page1/description",
      "msgid_plural": null,
      "msgstr": "The Laser Target Designator adds a special effect to your next shot, applied to any enemy you hit. The effect varies depending on whether the enemy was spotted at the moment of impact.\nTo activate Laser Target Designator, press:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/targetDesignator/page1/title",
      "msgid_plural": null,
      "msgstr": "Laser Target Designator",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/targetDesignator/page2/description",
      "msgid_plural": null,
      "msgstr": "Hitting a spotted enemy vehicle will mark it, extending the time it remains spotted and increasing the damage it receives from shells.\nHitting an unspotted enemy vehicle will highlight its location with a special marker.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/targetDesignator/page2/title",
      "msgid_plural": null,
      "msgstr": "Target Designation",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/twinGun/page1/description",
      "msgid_plural": null,
      "msgstr": "You can switch the fire mode from single fire mode to salvo fire mode depending on the tactical situation on the battlefield.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/twinGun/page1/title",
      "msgid_plural": null,
      "msgstr": "Fire Mode Switching Mechanic",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/twinGun/page2/description",
      "msgid_plural": null,
      "msgstr": "Salvo fire mode doubles both damage and reload time, and your vehicle loses dispersion at 100 m*.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/twinGun/page2/title",
      "msgid_plural": null,
      "msgstr": "Advantages and Disadvantages",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/wheeledDash/page1/description",
      "msgid_plural": null,
      "msgstr": "This mechanical modification significantly boosts the vehicle's forward and reverse acceleration, engine power, and top forward and reverse speed for a short time. Maintaining a high movement speed accelerates its cooldown.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/mechanics/wheeledDash/page1/title",
      "msgid_plural": null,
      "msgstr": "High-Pressure Turbocharger Assist",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/noKeysWarning",
      "msgid_plural": null,
      "msgstr": "The core keys have not been assigned. Assign them in game settings.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/pillboxSiege/mechanics/page1",
      "msgid_plural": null,
      "msgstr": "In this mode, gun accuracy, reload speed, and elevation/depression angles are drastically increased, but mobility (forward/reverse speed and vertical/horizontal traverse speed) is severely limited. To activate the mode, %(pressAndHold)s the hotkey:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/pillboxSiege/mechanics/page1/pressAndHold",
      "msgid_plural": null,
      "msgstr": "press and hold",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/pillboxSiege/mechanics/page1/title",
      "msgid_plural": null,
      "msgstr": "Pillbox Mode",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/pillboxSiege/mechanics/page2",
      "msgid_plural": null,
      "msgstr": "In this mode, gun accuracy, aiming speed, and elevation/depression angles are increased, but mobility (forward and reverse speed) is reduced. To activate the mode, press the hotkey:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/pillboxSiege/mechanics/page2/title",
      "msgid_plural": null,
      "msgstr": "Siege Mode",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/role/description",
      "msgid_plural": null,
      "msgstr": "Receive a bonus to experience by performing role actions:",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/role/title",
      "msgid_plural": null,
      "msgstr": "Vehicle Role in Battle",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/trackWithinTrack/description",
      "msgid_plural": null,
      "msgstr": "Allows for partially maintaining mobility when the main track is destroyed.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/trackWithinTrack/title",
      "msgid_plural": null,
      "msgstr": "Reserve Track",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/aboutTechnique",
      "msgid_plural": null,
      "msgstr": "French wheeled light vehicles demonstrate the highest speed and dynamics but have quite a mediocre view range. A stationary wheeled vehicle cannot turn on the spot.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/aboutTechnique/title",
      "msgid_plural": null,
      "msgstr": "Overview",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/burnout",
      "msgid_plural": null,
      "msgstr": "Press and hold %(key2)s and %(key1)s at the same time. The power bar's level affects the boost force. Release the %(key1)s key to activate the boost or release the %(key2)s key to cancel the boost. The boost provides fast acceleration that can be used for unexpected attacks and deceptive maneuvers. Attention! Boost can be used only after the vehicle has completely stopped. Activating boost damages your vehicle's engine.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/burnout/title",
      "msgid_plural": null,
      "msgstr": "Boost",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/stableChassis",
      "msgid_plural": null,
      "msgstr": "Wheeled vehicles receive reduced damage when landing on their wheels and do not stop with the destruction of one wheel. As more wheels are destroyed, the speed and handling of the vehicle are reduced. Wheeled vehicles are harder to immobilize—destroyed wheels are completely repaired after a certain period.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/stableChassis/title",
      "msgid_plural": null,
      "msgstr": "Durable Suspension",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/twoModes",
      "msgid_plural": null,
      "msgstr": "Press %(key1)s to switch mode. Vehicles demonstrate different speed, dynamics, and handling in each mode.",
      "msgstr_plural": null
    },
    {
      "msgid": "detailsHelp/wheeledVeh/twoModes/title",
      "msgid_plural": null,
      "msgstr": "Two Movement Modes",
      "msgstr_plural": null
    },
