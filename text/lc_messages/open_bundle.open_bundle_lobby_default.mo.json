    {
      "msgid": "intro/cards/description/c_1",
      "msgid_plural": null,
      "msgstr": "When you purchase bonds during the {{eventName}}, you will receive a reward from one of the unopened cells as a bonus gift. Cells contain valuable in-game items, including the event's main reward: a Premium vehicle.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/cards/description/c_2",
      "msgid_plural": null,
      "msgstr": "Rewards are granted in random order. Each unopened cell has its own probability of being selected, and all probabilities always total 100%. Once a cell is opened, it cannot be opened again, and the chances of receiving the remaining rewards increase.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/cards/description/c_3",
      "msgid_plural": null,
      "msgstr": "Each step costs a set amount of gold. Both the number of bonds received and the step price vary as you progress.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/cards/link",
