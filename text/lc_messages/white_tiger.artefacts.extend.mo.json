  "entries": [
    {
      "msgid": "builtinAfterburning_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinAfterburning_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinAfterburning_wt/features",
      "msgid_plural": null,
      "msgstr": "1. Use Charge to quickly move to points of interest.\n2. The speed boost it provides can help you escape dangerous areas.\n3. Use the ability to outmaneuver enemies or avoid taking damage.\n4. It also increases ramming damage.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinAfterburning_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinAfterburning_wt/name",
      "msgid_plural": null,
      "msgstr": "Charge",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinAfterburning_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Increases the vehicle's speed for a short period of time.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinAfterburning_wt/restriction",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinAfterburning_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/features",
      "msgid_plural": null,
      "msgstr": "1. Aim at Sentinels' rear with Railgun to set them on fire. \n2. The ability is very effective for long-range shots to distract and damage targets.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/name",
      "msgid_plural": null,
      "msgstr": "Railgun",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/onUse",
      "msgid_plural": null,
      "msgstr": "After the ability is activated, the shot that follows will be more accurate and will cause more damage to the enemy and their modules.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/restriction",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinChargedShot_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/features",
      "msgid_plural": null,
      "msgstr": "1. Use Explosive Shot to deal huge damage to large groups of enemies.\n2. Targets can be hit behind cover, even without a direct line of fire.\n3. Vehicles hiding behind hard cover will take reduced or no damage.\n4. The more enemies you hit, the more damage Explosive Shot causes.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/name",
      "msgid_plural": null,
      "msgstr": "Explosive Shot",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/onUse",
      "msgid_plural": null,
      "msgstr": "After the ability is activated, the shot that follows will explode on impact and cause a guaranteed amount of damage within a certain radius.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/restriction",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinExplosiveShot_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/descr",
      "msgid_plural": null,
      "msgstr": "Ermelinda's secret technology",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/features",
      "msgid_plural": null,
      "msgstr": "1. Hyperion charges as you cause damage to enemy vehicles.\n2. The Harriers will know when you fire this destructive ability.\n3. A single pulse will disrupt enemy defensive abilities such as Ballistic Dome and self-repair.\n4. Your own Sentinels and Blitzträger are immune from its damaging effects.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/name",
      "msgid_plural": null,
      "msgstr": "Hyperion",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Fires pulses of pure energy at the targeted area. After a few seconds, nothing will be left standing.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/restriction",
      "msgid_plural": null,
      "msgstr": "The ability is only available with an active shield.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinHyperion_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/features",
      "msgid_plural": null,
      "msgstr": "1. EMP Burst passes through obstacles, making it effective against fast-moving targets.\n2. It removes enemy effects and buffs.\n3. While enemies are stunned, their abilities are disabled.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/name",
      "msgid_plural": null,
      "msgstr": "EMP Burst",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/onUse",
      "msgid_plural": null,
      "msgstr": "A charge of energy that covers the area around the vehicle, stuns all enemy vehicles in the impact area, and causes damage to those closest. It passes through all obstacles and resets Generator Overload points from vehicles in the impact area.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/restriction",
      "msgid_plural": null,
      "msgstr": "The ability is only available with an active shield.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinImpulse_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/features",
      "msgid_plural": null,
      "msgstr": "1. EMP Arrow stuns vehicles—use it to slow down enemies before dealing damage to them.\n2. It has a small area of effect, allowing you to stun targets without hitting them directly.\n3. EMP Arrow can be used even when the gun is not loaded.\n4. It removes enemy effects and buffs.\n5. While enemies are stunned, their abilities are disabled.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/name",
      "msgid_plural": null,
      "msgstr": "EMP Arrow",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/onUse",
      "msgid_plural": null,
      "msgstr": "A shot with a high-voltage charge that slows down, stuns, and disables enemies. An EMP Arrow hit can interrupt Generator overloading.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/restriction",
      "msgid_plural": null,
      "msgstr": "The ability is only available with an active shield.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinInstantStunShoot_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/always",
      "msgid_plural": null,
      "msgstr": "%(crewHitChance)s to protection of the crew from injuries",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/descr",
      "msgid_plural": null,
      "msgstr": "Treatment of all injured crew members and removing the stun effect.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/long_special",
      "msgid_plural": null,
      "msgstr": "Treats all injured crew members upon activation. The passive effect protects the crew from injuries. This consumable is suitable for all vehicle types of any nation.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/name",
      "msgid_plural": null,
      "msgstr": "Large First Aid Kit",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Treatment of all injured crew members. Can be used multiple times in a battle. Cannot be spent.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/restriction",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/short_special",
      "msgid_plural": null,
      "msgstr": "Treats all injured crew members",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinLargeMedkit_wt/stunDisabled/descr",
      "msgid_plural": null,
      "msgstr": "Treatment of all injured crew members.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinRepairkit_wt/always",
      "msgid_plural": null,
      "msgstr": "%(vehicleRepairSpeed)s to module repair speed",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinRepairkit_wt/descr",
      "msgid_plural": null,
      "msgstr": "Repair of all damaged modules.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinRepairkit_wt/long_special",
      "msgid_plural": null,
      "msgstr": "Repairs all damaged modules at once upon activation. It also passively increases the repair speed.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinRepairkit_wt/name",
      "msgid_plural": null,
      "msgstr": "Large Repair Kit",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinRepairkit_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Repair of all damaged modules. Can be used multiple times in a battle. Cannot be spent.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinRepairkit_wt/restriction",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/features",
      "msgid_plural": null,
      "msgstr": "1. Use Full Repair between combat situations to completely repair your vehicle.\n2. The repair effect will stop when you receive damage.\n3. Make use of the ability during combat or while Hyperion is active to receive a small amount of HP that may just keep you in the fight.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/name",
      "msgid_plural": null,
      "msgstr": "Full Repair",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Restores the vehicle's hit points until it is at full durability or receives damage.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/restriction",
      "msgid_plural": null,
      "msgstr": "The ability can only be used when your vehicle is damaged.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinSelfRepair_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/features",
      "msgid_plural": null,
      "msgstr": "1. Ballistic Dome has a short duration—use it in critical situations to protect yourself from enemy shells.\n2. It also prevents you from being stunned.\n3. Remember: Ballistic Dome does not protect you from ramming and falling.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/name",
      "msgid_plural": null,
      "msgstr": "Ballistic Dome",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Renders your vehicle invulnerable to stuns and damage from shells for a certain period of time.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/restriction",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinShield_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/descr",
      "msgid_plural": null,
      "msgstr": "Combat Ability",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/features",
      "msgid_plural": null,
      "msgstr": "1. Siege mode drastically decreases your vehicle's mobility, as well as your chances of escape—so use it wisely.\n2. The vehicle has excellent elevation and depression angles, allowing you to use terrain irregularities to your advantage.\n3. It also has high survivability, helping you support allies in battle.\n4. You can cancel Siege mode's effect by activating it again. The remaining duration will be deducted from its cooldown.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/name",
      "msgid_plural": null,
      "msgstr": "Siege Mode",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Increases the vehicle's fire rate but decreases its mobility for a certain period of time.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/restriction",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinStronghold_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/always",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/descr",
      "msgid_plural": null,
      "msgstr": "Von Krieger's secret technology",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/features",
      "msgid_plural": null,
      "msgstr": "1. The Harriers will know when you use Teleportation, but they will not know where you will appear.\n2. Stay close to the Harriers—wandering too far may leave you out of position when it matters most.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/long_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/name",
      "msgid_plural": null,
      "msgstr": "Teleportation",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/onUse",
      "msgid_plural": null,
      "msgstr": "Allows the vehicle to teleport to a selected point on the map after some delay. Operating the vehicle is impossible during preparation.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/restriction",
      "msgid_plural": null,
      "msgstr": "The ability is only available with an active shield.",
      "msgstr_plural": null
    },
    {
      "msgid": "builtinTeleport_wt/short_special",
      "msgid_plural": null,
      "msgstr": "?empty?",
      "msgstr_plural": null
    }
  ]
}
