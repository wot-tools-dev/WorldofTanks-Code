    {
      "msgid": "intro/description/lightGameplay",
      "msgid_plural": null,
      "msgstr": "Enjoy the gameplay of the original Onslaught mode without Qualification, Ranks or any Service Records.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/description/onslaughtModifiers",
      "msgid_plural": null,
      "msgstr": "The mode has modifiers that change certain parameters of the vehicle, such as vehicle hit points, consumables cooldown time, time remaining visible, and more.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/description/pointsOfInterest",
      "msgid_plural": null,
      "msgstr": "Once you capture certain areas of the map, you will be able to use Tactical Skills. There are two types of Points of Interest: the Artillery Headquarters will allow you to direct an artillery strike on a certain position, and the Comms Center will spot all enemy vehicles. Depending on the map, the presence and location of these Points of Interest can change.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/description/roleSkills",
      "msgid_plural": null,
      "msgstr": "Depending on the role, each vehicle has a special skill with three charge levels. The higher the charge level when the skill is activated, the stronger the effect will be. The charge level will depend on the number of Prestige Points that can be earned for impressive performance in battle, capturing Points of Interest, using Tactical Skills, etc.\n\nCheck out the mode regulations to learn more about the different ways you can earn Prestige Points.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/description/vehiclesOnMap",
      "msgid_plural": null,
      "msgstr": "Only %(levels)s vehicles can be used in the mode (SPGs and some other tanks are not available). Prepare your vehicles in the Garage, then choose the best one based on the features of the given map once you get into battle. When selecting your vehicle, also consider which vehicles your allies have chosen.",
      "msgstr_plural": null
    },
    {
      "msgid": "intro/title/lightGameplay",
