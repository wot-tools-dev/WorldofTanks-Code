    },
    {
      "msgid": "infoPage/footer/description/compensation",
      "msgid_plural": null,
      "msgstr": "If you already own all vehicles from the list of possible Blazing Treasure contents, then all subsequent vehicles you receive from Blazing Treasures will be compensated in gold equal to their full value.",
      "msgstr_plural": null
    },
    {
      "msgid": "infoPage/footer/description/guaranteed",
      "msgid_plural": null,
      "msgstr": "Every %(guaranteed0)s Blazing Treasures are guaranteed to contain a Tier VIII–IX vehicle. If you open them without one dropping such a vehicle, then a Tier VIII–IX vehicle you do not already own will drop when you open the %(guaranteed0)s&zwnbsp;th Blazing Treasure. When it does, the counter is reset.",
      "msgstr_plural": null
    },
    {
      "msgid": "infoPage/header/description",
