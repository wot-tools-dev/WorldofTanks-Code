    {
      "msgid": "tooltip/minor/angle/description",
      "msgid_plural": null,
      "msgstr": "The angle between the shell trajectory and the line perpendicular to the armor plate.\n\nThe shell trajectory is calculated as if the shell moves in a straight line from the center of the screen.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/angle/header",
      "msgid_plural": null,
      "msgstr": "Hit angle",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/damage/description",
      "msgid_plural": null,
      "msgstr": "The chance of penetrating enemy armor and causing damage to the vehicle.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/damage/header",
      "msgid_plural": null,
      "msgstr": "Penetration chance",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/effective/description",
      "msgid_plural": null,
      "msgstr": "For a single armor layer, effective armor is the nominal armor modified by the hit angle and shell normalization.\n\nIf there are multiple armor layers at the point of impact, the result is the sum of the effective values for each layer.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/effective/header",
      "msgid_plural": null,
      "msgstr": "Effective armor",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/header",
      "msgid_plural": null,
      "msgstr": "Legend",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/noDamage/description",
      "msgid_plural": null,
      "msgstr": "Hitting spaced armor does not damage a vehicle unless a shell hits and then penetrates the main armor after that.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/noDamage/header",
      "msgid_plural": null,
      "msgstr": "No damage",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/nominal/description",
      "msgid_plural": null,
      "msgstr": "The actual width of the main or spaced armor plate(s).",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/nominal/header",
      "msgid_plural": null,
      "msgstr": "Nominal armor",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/ricochet/description",
      "msgid_plural": null,
      "msgstr": "Shells that hit enemy armor at a glancing angle will ricochet off it. However, they may still strike another vehicle, or even the same one.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minor/ricochet/header",
      "msgid_plural": null,
      "msgstr": "Ricochet",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/attackingConfiguration/description",
      "msgid_plural": null,
      "msgstr": "Affects calculations of effective armor and penetration chance.\n\nA distance of 100 m is used for all calculations (AP and APCR shells lose penetration power over distance).\n\nCrew perks and attacking vehicle upgrades do not affect the calculations.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/attackingConfiguration/header",
      "msgid_plural": null,
      "msgstr": "Attacker configuration",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/damageChance/description",
      "msgid_plural": null,
      "msgstr": "The chance of penetrating enemy armor and causing damage to the vehicle.\n\nHitting spaced armor does not damage a vehicle unless a shell hits and then penetrates the main armor after that.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/damageChance/header",
      "msgid_plural": null,
      "msgstr": "Penetration chance",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/mainArmor/description",
      "msgid_plural": null,
      "msgstr": "A vehicle is only damaged if its main armor is hit and penetrated. HE shells can cause reduced damage to a vehicle even without penetration; however, they must still reach the main armor.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/mainArmor/header",
      "msgid_plural": null,
      "msgstr": "Main armor",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/noDamage/description",
      "msgid_plural": null,
      "msgstr": "Hitting spaced armor does not damage a vehicle unless a shell hits and then penetrates the main armor after that.\n\nHitting and penetrating external modules damages those modules directly: hit a track to immobilize a vehicle, hit a gun to disable it, or hit an observation device to reduce a vehicle's view range.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/noDamage/header",
      "msgid_plural": null,
      "msgstr": "No damage",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/ricochet/description",
      "msgid_plural": null,
      "msgstr": "The ricochet angle is 70 degrees for armor-piercing and APCR shells and 85 degrees for HEAT shells.\n\nHE shells do not ricochet, while AP and APCR shells lose 25% of their penetration power after ricocheting.\n\nA ricochet will not occur if the shell's caliber is greater than three times the nominal armor thickness at the point of impact (this only applies to AP and APCR shells).",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/ricochet/header",
      "msgid_plural": null,
      "msgstr": "Ricochet",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/spacedArmor/description",
      "msgid_plural": null,
      "msgstr": "Hitting spaced armor does not damage a vehicle unless a shell hits and then penetrates the main armor after that.\n\nHitting and penetrating external modules damages those modules directly: hit a track to immobilize a vehicle, hit a gun to disable it, or hit an observation device to reduce a vehicle's view range.\n\nHit angle does not apply to external modules (such as tracks and gun)—here, effective armor equals nominal armor.",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/minorShort/spacedArmor/header",
      "msgid_plural": null,
      "msgstr": "Spaced armor",
      "msgstr_plural": null
    },
    {
      "msgid": "tooltip/reductionAndArmor/value",
      "msgid_plural": null,
      "msgstr": "{{reduction}}{{value}} mm",
      "msgstr_plural": null
    },
    {
      "msgid": "videoTooltip",
      "msgid_plural": null,
      "msgstr": "Watch a video on armor penetration mechanics",
      "msgstr_plural": null
    }
  ]
}
