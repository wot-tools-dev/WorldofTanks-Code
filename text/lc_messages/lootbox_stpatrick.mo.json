    },
    {
      "msgid": "infoPage/footer/description/guaranteed",
      "msgid_plural": null,
      "msgstr": "Every %(guaranteed0)s chests are guaranteed to contain a Tier VIII–IX vehicle. If you open them without one dropping such a vehicle, then a Tier VIII–IX vehicle you do not already own will drop when you open the %(guaranteed0)s&zwnbsp;th chest. When it does, the counter is reset.",
      "msgstr_plural": null
    },
    {
