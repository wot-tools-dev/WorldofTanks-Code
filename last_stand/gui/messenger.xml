<messenger.xml>
  <htmlTemplatesSimple>
    <LSBattleResultWaves>	&lt;br/&gt;&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/wavesCompleted)&lt;/font&gt;	</LSBattleResultWaves>
    <LSBattleResultQuest>	&lt;br/&gt;&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/questCompleted)&lt;br/&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/artefacts): &lt;font color='#C8C8B5'&gt;%(artefacts)s&lt;/font&gt;&lt;/font&gt;	</LSBattleResultQuest>
    <LSBattleResultQuests>	&lt;br/&gt;&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/questsCompleted)&lt;br/&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/artefacts): &lt;font color='#C8C8B5'&gt;%(artefacts)s&lt;/font&gt;&lt;/font&gt;	</LSBattleResultQuests>
  </htmlTemplatesSimple>
  <htmlTemplates>
    <lsProgressPointsMessage>
      <priority>	medium	</priority>
      <type>	grey	</type>
      <icon>	lsArtefactKey	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color="#8C8C7E"&gt;%(description)s&lt;/font&gt;	</message>
    </lsProgressPointsMessage>
    <lsPurchaseBundleForGoldSysMessage>
      <type>	yellow	</type>
      <icon>	GoldIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(description)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(additionalText)s&lt;/font&gt;	</message>
    </lsPurchaseBundleForGoldSysMessage>
    <lsDifficultyOpenMessageSysMessage>
      <type>	grey	</type>
      <icon>	InformationIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(text)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(description)s&lt;/font&gt;	</message>
    </lsDifficultyOpenMessageSysMessage>
    <lsBattlePassPointsMessage>
      <type>	yellow	</type>
      <icon>	lsBattlePassPoints	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/invoiceReceived/invoice)&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/currencyUpdate/date):&lt;/font&gt; &lt;font color='#8C8C7E'&gt;%(at)s&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:platformCurrencyMsg/received/bpbit): &lt;/font&gt;&lt;br/&gt;&lt;font color='#C8C8B5'&gt;%(bpPoints)s&lt;/font&gt;	</message>
    </lsBattlePassPointsMessage>
    <LSBattleVictoryResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgLSBattleResultIconVictory	</bgIcon>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/battleResults/victory)!&lt;/font&gt;
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/battleTypeName)&lt;/font&gt;
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/difficulty): %(difficultyLevel)s&lt;/font&gt;%(finalResult)s
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/tank): %(vehicleNames)s&lt;/font&gt;
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/progressPoints): &lt;font color='#C8C8B5'&gt;%(progressPoints)s&lt;/font&gt;%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(equipCoinStr)s&lt;font color='#929290'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(badges)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s	</message>
    </LSBattleVictoryResult>
    <LSBattleDefeatResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgLSBattleResultIconDefeat	</bgIcon>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/battleResults/ended)&lt;/font&gt;
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/battleTypeName)&lt;/font&gt;
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/difficulty): %(difficultyLevel)s&lt;/font&gt;%(finalResult)s
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/tank): %(vehicleNames)s&lt;/font&gt;
&lt;font color='#929290'&gt;_(#last_stand.last_stand_system_messages:serviceChannelMessages/battleResults/progressPoints): &lt;font color='#C8C8B5'&gt;%(progressPoints)s&lt;/font&gt;%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(equipCoinStr)s&lt;font color='#929290'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(badges)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s	</message>
    </LSBattleDefeatResult>
  </htmlTemplates>
</messenger.xml>
