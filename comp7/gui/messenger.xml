<messenger.xml>
  <htmlTemplates>
    <Comp7ShopItemsAvailableForRankSysMessage>
      <type>	yellow	</type>
      <icon>	InformationIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(header)s&lt;/font&gt;&lt;br/&gt;&lt;font color='#8C8C7E'&gt;%(text)s&lt;/font&gt;	</message>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#comp7.comp7_ext:system_messages/shop/offer/button)	</label>
          <action>	openComp7Shop	</action>
          <width>	120	</width>
        </button>
      </buttonsLayout>
    </Comp7ShopItemsAvailableForRankSysMessage>
    <comp7SeasonBattleVictoryResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgBattleResultIconVictory	</bgIcon>
      <bgIconHeight>	100	</bgIconHeight>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/battleResults/victory)!&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s &lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;&lt;font color='#8C8C7E'&gt;%(xp)s%(xpEx)s%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(ratingPointsStr)s&lt;font color='#8C8C7E'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s	</message>
    </comp7SeasonBattleVictoryResult>
    <comp7SeasonBattleDrawGameResult>
      <type>	battleResult	</type>
      <icon>	BattleResultIcon	</icon>
      <bgIcon>	BgBattleResultIconDraw	  <FORT_BATTLE>	frtClanBtlBgBattleResult_UR_Draw	</FORT_BATTLE>
      </bgIcon>
      <bgIconHeight>	100	</bgIconHeight>
      <buttonsLayout>
        <button>
          <type>	submit	</type>
          <label>	_(#messenger:serviceChannelMessages/battleResults/button)	</label>
          <action>	showBattleResults	</action>
        </button>
      </buttonsLayout>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;_(#messenger:serviceChannelMessages/battleResults/drawGame)&lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/battle): %(arenaName)s &lt;/font&gt;
&lt;font color='#8C8C7E'&gt;_(#messenger:serviceChannelMessages/battleResults/tanks): %(vehicleNames)s&lt;/font&gt;&lt;font color='#8C8C7E'&gt;%(xp)s%(xpEx)s%(battlePassProgress)s&lt;/font&gt;%(crystalStr)s%(gold)s%(eventCoinStr)s%(bpcoinStr)s%(ratingPointsStr)s&lt;font color='#8C8C7E'&gt;%(credits)s%(creditsEx)s&lt;/font&gt;%(rankedProgress)s%(rankedBonusBattles)s%(achieves)s%(lock)s%(quests)s%(piggyBank)s%(platformCurrencyStr)s	</message>
