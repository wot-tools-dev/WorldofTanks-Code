    <comp7PeriodicRewardMessage>
      <priority>	medium	</priority>
      <type>	grey	</type>
      <icon>	CrystalIcon	</icon>
      <message>	&lt;font face="$TitleFont" size="15" color="#E9E2BF"&gt;%(title)s&lt;/font&gt;&lt;br/&gt;&lt;font color="#8C8C7E"&gt;%(body)s&lt;/font&gt;	</message>
